NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://casino:change-this-password@localhost:5432/casino
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGIN=http://localhost:3000
# Hard safety switch. Keep false until legal approval, licensing, KYC/AML,
# independent testing and payment-provider approval are verified per market.
REAL_MONEY_ENABLED=false

# Optional: HMAC secret shared only with a trusted geo-IP edge proxy.
# Without it, country verification fails closed. Never expose this secret to browsers.
GEOIP_SHARED_SECRET=
